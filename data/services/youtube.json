{
    "id": "youtube",
    "name": "Youtube",
    "vendor": "Google",
    "purposes": [
        "functional",
        "marketing"
    ],
    "privacyPolicyUrl": "https://business.safety.google/privacy/",
    "matches": {
        "cookies": [
            {
                "name": "GPS",
                "requireOrigin": "youtube.com"
            },
            "VISITOR_INFO1_LIVE",
            "PREF",
            {
                "name": "YSC",
                "requireOrigin": "youtube.com"
            },
            "DEVICE_INFO",
            "LOGIN_INFO",
            "VISITOR_PRIVACY_METADATA",
            "__Secure-ROLLOUT_TOKEN"
        ],
        "origins": [
            "youtube.com",
            "*.youtube.com",
            "*.googlevideo.com",
            "*.ytimg.com"
        ],
        "aliasOrigins": [
            "youtube-nocookie.com",
            "*.youtube-nocookie.com"
        ]
    },
    "placeholderDescription": "This YouTube embed is hosted by Google and will set tracking cookies when loaded.",
    "i18n": {
        "placeholderDescription": {
            "de": "Dieses YouTube-Video wird von Google bereitgestellt und setzt Tracking-Cookies, sobald es geladen wird."
        }
    }
}
